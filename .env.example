# ==============================================================================
# PARALLAX STUDIO V2 — CẤU HÌNH MÔI TRƯỜNG (.env)
# Chỉnh sửa trực tiếp các giá trị bên dưới rồi khởi động lại ứng dụng để áp dụng.
# Lưu ý: File `.env` chỉ lưu trên máy cá nhân (đã được .gitignore bảo vệ).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TĂNG TỐC PHẦN CỨNG RUST NATIVE 64-BIT (NAPI-RS + RAYON)
# ------------------------------------------------------------------------------
# 0 = Dùng addon Rust Native 64-bit (.node) tốc độ cao | 1 = Ép dùng WASM 32-bit dự phòng
PXS_DISABLE_NAPI=0

# Số luồng CPU dành cho Rust Rayon khi chuyển màu video YUV420p, băm file & nén .pxs
# 0 = Tự động bung toàn bộ nhân CPU trên máy | Đặt số cụ thể (2, 4, 8...) nếu muốn giới hạn CPU
RAYON_NUM_THREADS=0

# ------------------------------------------------------------------------------
# 2. ĐỒ HOẠ GPU & GIAO DIỆN PHÁT TRIỂN (ELECTRON / WEBGL ANGLE)
# ------------------------------------------------------------------------------
# Backend đồ hoạ WebGL trên Windows: d3d11on12 (khuyến nghị) | d3d11 | gl | vulkan
PARALLAX_ANGLE=d3d11on12

# Bật gắn định vị mã nguồn (data-ai-src) cho AI UI Inspector (Win + Alt) khi chạy dev
# 1 = Bật đầy đủ | 0 = Tắt tạm để tăng tốc độ biên dịch Vite HMR
PXS_AI_SRC=1

# ------------------------------------------------------------------------------
# 3. XUẤT VIDEO MP4 (FFMPEG)
# ------------------------------------------------------------------------------
# Đường dẫn tuỳ chỉnh tới ffmpeg.exe (để trống = tự nhận diện bin/ffmpeg.exe hoặc ffmpeg-static)
FFMPEG_BIN=

# ------------------------------------------------------------------------------
# 4. KẾT NỐI AI MCP SERVER & CLI (pnpm pxs)
# ------------------------------------------------------------------------------
# 1 = Tự bật lắng nghe MCP khi mở ứng dụng | 0 = Tắt MCP lúc khởi động
PARALLAX_MCP=1

# Cổng TCP cục bộ (127.0.0.1) cho MCP Bridge và công cụ dòng lệnh `pnpm pxs`
PARALLAX_MCP_PORT=9877

# Ghi đè ngôn ngữ tài liệu MCP (vi | en). Để trống = theo nút chuyển trong hộp thoại MCP của app
PARALLAX_MCP_LANG=

# Thời gian chờ tối đa (ms) cho mỗi lệnh `pnpm pxs` (mặc định 300000 = 5 phút)
PXS_TIMEOUT_MS=300000

# ------------------------------------------------------------------------------
# 5. ĐIỀU KHIỂN TỪ XA QUA WI-FI / MÃ QR (REMOTE STUDIO)
# ------------------------------------------------------------------------------
# 1 = Tự bật máy chủ Remote Studio khi mở ứng dụng | 0 = Tắt lúc khởi động
PARALLAX_REMOTE=1

# Cổng mạng LAN để điện thoại / máy tính bảng quét QR kết nối
PARALLAX_REMOTE_PORT=9878

# ------------------------------------------------------------------------------
# 6. GƯƠNG TẢI THƯ VIỆN KHI CÀI ĐẶT (setup.bat / start.bat)
# ------------------------------------------------------------------------------
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
FFMPEG_BINARIES_URL=https://registry.npmmirror.com/-/binary/ffmpeg-static

    "ffmpeg-static": "^5.3.0",
    "immer": "^11.1.21",
    "jszip": "^3.10.2",
    "nanoid": "^6.0.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
